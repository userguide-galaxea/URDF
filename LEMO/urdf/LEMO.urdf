  <!--
    LEMO dual-arm platform. Base mesh registration is estimated from supplied data.
    All URDF lengths are metres. The supplied mounting positions were:
      L: (0,  375, 5) mm -> (0,  0.375, 0.005) m
      R: (0, -375, 5) mm -> (0, -0.375, 0.005) m
    Both A1Z mounting frames use rpy="0 0 0".
  -->
  <link name="base_link">
    <inertial>
      <!-- CAD coordinate system 1; COM-frame inertia, kg and kg*m^2. -->
      <origin xyz="-0.02160 0.00002 0.05864" rpy="0 0 0" />
      <mass value="3.875" />
      <inertia
        ixx="0.24458853409"
        ixy="0.00000170400"
        ixz="0.00148173449"
        iyy="0.06138824474"
        iyz="0.00000467402"
        izz="0.19974996832" />
    </inertial>
    <visual>
      <!-- Estimated STL registration; see config/base_mass_properties.json. -->
      <origin xyz="0.067162597748 -0.520366392271 -0.000548149153" rpy="1.5707963267948966 0 3.141592653589793" />
      <geometry>
        <mesh filename="package://lemo_description/meshes/base_link.STL"
              scale="0.001 0.001 0.001" />
      </geometry>
      <material name="platform_gray">
        <color rgba="0.45 0.48 0.52 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.067162597748 -0.520366392271 -0.000548149153" rpy="1.5707963267948966 0 3.141592653589793" />
      <geometry>
        <mesh filename="package://lemo_description/meshes/base_link.STL"
              scale="0.001 0.001 0.001" />
      </geometry>
    </collision>
  </link>

